# FLAME EVIDENCE LAB — environment configuration
#
# Copy to `.env` for local development:  cp .env.example .env
# .env is git-ignored; NEVER commit real credentials.
#
# The AI key is configured in production via:
#   1. GitHub repo secret  AI_API_KEY        (repo Settings → Secrets and variables → Actions)
#   2. Cloudflare Worker secret (wrangler secret put AI_API_KEY)
# The client never sees the key — only the server-side copilot route reads it.

# ---- AI provider (OpenAI-compatible chat completions) ----
# Required for live CIR-1 LLM reasoning; without it the copilot runs in its
# labelled deterministic fallback mode (tools + calculations still work).
AI_API_KEY=sk-your-key-here

# Optional overrides — any OpenAI-compatible provider works:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
