// Cloudflare Workers deployment configuration (OpenNext Cloudflare adapter).
// Deploy: npm run cf:deploy   (builds with OpenNext, then `wrangler deploy`)
// The AI_API_KEY secret is set with `wrangler secret put AI_API_KEY` (or the
// GitHub Actions pipeline) — it is NEVER placed in this file or any commit.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flame-evidence-lab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
